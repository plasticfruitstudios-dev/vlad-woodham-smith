---
import Base from './Base.astro';
import Credits from '../components/Credits.astro';
import Media from '../components/Media.astro';
import FilmScript from '../components/FilmScript.astro';
import MainPlayer from '../components/MainPlayer.astro';
import '../styles/film.css';

import gridMoving from '../data/grid-moving-image.json';
import gridIndex from '../data/grid-index.json';
import gridColour from '../data/grid-colour.json';

const { entry } = Astro.props;
const d = entry.data;
// col-* projects live in the colour section; everything else in moving image
const section = entry.id.startsWith('col-') ? 'colour' : 'moving-image';
// the poster this project's card shows on the grids — the morph lands on the
// same frame instead of a black box while the Vimeo player loads
const card = [...gridMoving.rows, ...gridColour.rows, ...gridIndex.rows].flatMap((r) => r.cards).find((c) => c.slug === entry.id);
const posterBg = card?.media?.poster ? `background:#111111 url('/${card.media.poster}') center/cover no-repeat;` : '';
---
<Base title={d.pageTitle} description={d.description} path={entry.id}
      ogTitle={d.ogTitle} ogImage={d.ogImage} active={section} bodyClass="kind-film">
  <div class="project-wrap">
    <div class="project-meta">
      <h1 class="artist">{d.title}</h1>
      {d.subtitle && <div class="title">{d.subtitle}</div>}
      <Credits credits={d.credits} />
      {d.ext && <a class="ext" href={d.ext.href} target="_blank" rel="noopener">{d.ext.label} &#8599;</a>}
    </div>
    {(d.media.length > 0 || d.stackPlayer) ? (
      <div class="player-stack">
        <MainPlayer slug={entry.id} posterBg={posterBg} vimeo={d.vimeo} embed={d.embed} />
        {d.media.map((m) => <Media item={m} />)}
      </div>
    ) : (
      <MainPlayer slug={entry.id} posterBg={posterBg} vimeo={d.vimeo} embed={d.embed} />
    )}
  </div>
  <a class="back-bottom" href={'/' + section}>&larr; back</a>
  <FilmScript slot="after-scripts" />
</Base>
