---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GridCard from '../components/GridCard.astro';
import SwitchPill from '../components/SwitchPill.astro';
import GridReveal from '../components/GridReveal.astro';
import grid from '../data/grid-colour.json';
import '../styles/grid.css';

const projects = await getCollection('projects');
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p.data]));
---
<Base title="Colour — Vlad Woodham-Smith"
      description="Colour grading by Vlad Woodham-Smith — music videos, commercials and live film."
      path="colour" ogImage="images/og/nieve-ella.jpg" active="colour">
  <h1 class="sr-only">Colour — grading by Vlad Woodham-Smith</h1>
  <div class="projects">
    {grid.rows.map((row) => (
      <div class={row.class ?? "row"}>
        {row.cards.map((card) => <GridCard card={card} project={bySlug[card.slug]} />)}
      </div>
    ))}
  </div>
  <GridReveal slot="after-scripts" />
  <SwitchPill active="colour" slot="after-scripts" />
</Base>
