---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GridCard from '../components/GridCard.astro';
import SwitchPill from '../components/SwitchPill.astro';
import GridReveal from '../components/GridReveal.astro';
import grid from '../data/grid-index.json';
import { DEFAULT_DESCRIPTION, PERSON } from '../lib/site.js';
import '../styles/grid.css';

const projects = await getCollection('projects');
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p.data]));
---
<Base title="All Work — Vlad Woodham-Smith" description={DEFAULT_DESCRIPTION} path=""
      ogImage="stills/web/ally-salort_cover-large.jpg" jsonld={PERSON} active="index">
  <h1 class="sr-only">Vlad Woodham-Smith — cinematographer, London</h1>
  <div class="projects">
    {grid.rows.map((row) => (
      <div class={row.class ?? "row"}>
        {row.cards.map((card) => <GridCard card={card} project={bySlug[card.slug]} />)}
      </div>
    ))}
  </div>
  <GridReveal slot="after-scripts" />
  <SwitchPill active="all" slot="after-scripts" />
</Base>
